# PostgreSQL (docker compose up -d starts one with these values)
DATABASE_URL="postgresql://leadradar:leadradar@localhost:5432/leadradar?schema=public"

# Generate with: openssl rand -base64 32
JWT_SECRET="change-me-to-a-long-random-string"

# Nominatim and Overpass require an identifying contact in the User-Agent
CONTACT_EMAIL="you@example.com"
